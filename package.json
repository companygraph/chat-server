{
  "name": "companygraph-chat-server",
  "version": "0.27.0",
  "description": "A chat over any CompanyGraph MCP host: the model asked in prose, answered from its tools",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "bin",
    "deploy",
    "types/lib",
    "types/deploy"
  ],
  "bin": {
    "companygraph-chat-http": "bin/http.mjs",
    "companygraph-chat-deploy": "bin/deploy.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/lib/http.d.mts",
      "default": "./lib/http.mjs"
    },
    "./errors": {
      "types": "./types/lib/errors.d.mts",
      "default": "./lib/errors.mjs"
    },
    "./config": {
      "types": "./types/lib/config.d.mts",
      "default": "./lib/config.mjs"
    },
    "./shape": {
      "types": "./types/lib/shape.d.mts",
      "default": "./lib/shape.mjs"
    },
    "./page": {
      "types": "./types/lib/page.d.mts",
      "default": "./lib/page.mjs"
    },
    "./deploy/tests": {
      "types": "./types/deploy/test/index.d.mts",
      "default": "./deploy/test/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:check": "node tools/build-check.mjs",
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/fixtures.mjs",
    "pretest": "node scripts/fixtures.mjs",
    "test": "node --test 'test/*.test.mjs'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@modelcontextprotocol/client": "^2.0.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/vertex-sdk": "^0.19.10",
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "@google-cloud/firestore": "^7.11.0",
    "google-auth-library": "^9.15.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "companygraph-mcp-server": "github:companygraph/mcp-server#v0.54.0",
    "playwright": "^1.63.0",
    "typescript": "7.0.2"
  }
}
